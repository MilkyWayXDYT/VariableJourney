  m_text: "\u0412 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u0432\u0441\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
    \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C\u0438. \u041F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
    \u2013 \u044D\u0442\u043E \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u043F\u0430\u043C\u044F\u0442\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0445\u0440\u0430\u043D\u0438\u0442
    \u0434\u0430\u043D\u043D\u044B\u0435. \r\n\u0414\u043B\u044F \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u043E\u0439
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u043D\u0430\u0442\u044C \u043A\u0430\u043A\u043E\u0439
    \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0438\u043F \u0434\u0430\u043D\u043D\u044B\u0445
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0432 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439.\r\n\u0422\u0438\u043F\u0438\u0437\u0430\u0446\u0438\u044F
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0430\u0436\u043D\u044B\u043C
    \u044D\u0442\u0430\u043F\u043E\u043C \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438.\r\n"
